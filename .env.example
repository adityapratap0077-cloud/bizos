# ── BizOS environment variables ─────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values from your free
# Supabase project: https://supabase.com/dashboard → Project Settings → API

# Public Supabase project URL (safe to expose — it is a public identifier)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co

# Supabase "anon" public key (safe to expose — Row Level Security protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── SECURITY NOTE ─────────────────────────────────────────────────────────────
# The Supabase SERVICE-ROLE key is NEVER needed by BizOS and must NEVER be
# placed in this file, in any .env file, or in any client-side code.
# Every database query runs with the anon key under strict Row Level Security
# policies, so each user can only ever read or modify their own business data.
